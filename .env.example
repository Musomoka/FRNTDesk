# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Ports are shifted off the defaults (5433/6380) so they do not collide with a
# locally installed Postgres 18 or Redis.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000

# --- Database / queue -------------------------------------------------------
DATABASE_URL=postgresql://frntdesk:frntdesk@localhost:5433/frntdesk?schema=public
REDIS_URL=redis://localhost:6380

# --- Auth (Auth0) ------------------------------------------------------------
# Identity is Auth0's job end to end — see README's "Auth0 setup" section for
# the exact dashboard steps. All four values below are non-secret (this is a
# public SPA client using Authorization Code + PKCE; there is no client
# secret to protect), so they're safe to bake into the frontend build.
#
# From Auth0 > Applications > Applications > (your Single Page Application):
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-with-spa-client-id
# From Auth0 > Applications > APIs > (the API you created for this backend):
AUTH0_AUDIENCE=https://api.frntdesk.zm

# --- Email ------------------------------------------------------------------
# dev = Mailpit on localhost:1025 (UI at http://localhost:8025)
MAIL_TRANSPORT=smtp
MAIL_FROM="FRNTDesk <no-reply@frntdesk.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Production alternative: MAIL_TRANSPORT=resend
RESEND_API_KEY=

# --- Payments: shared -------------------------------------------------------
CURRENCY=ZMW

# --- Payments: MTN MoMo Collections ----------------------------------------
# Sandbox self-service: https://momodeveloper.mtn.com
PROVIDER_MTN_ENABLED=true
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
# "sandbox" locally; "mtnzambia" in production.
MTN_TARGET_ENVIRONMENT=sandbox
# The MoMo sandbox REJECTS every currency except EUR. The database always
# records ZMW; this is only what goes on the wire. Set to ZMW in production.
MTN_WIRE_CURRENCY=EUR
# Must be publicly reachable — use an ngrok/cloudflared tunnel in development.
MTN_CALLBACK_URL=https://example.ngrok.app/api/payments/callbacks/mtn

# --- Payments: Airtel Money Collections -------------------------------------
# No self-service sandbox: credentials require business verification, so this
# stays off until Airtel onboarding completes.
PROVIDER_AIRTEL_ENABLED=false
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=ZM
AIRTEL_CURRENCY=ZMW
AIRTEL_CALLBACK_URL=https://example.ngrok.app/api/payments/callbacks/airtel

# --- Payments: fake provider ------------------------------------------------
# Drives e2e tests and local development without touching a real operator.
PROVIDER_FAKE_ENABLED=true

# --- LiveKit ----------------------------------------------------------------
# From https://cloud.livekit.io project settings.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WEBHOOK_ENABLED=true
LIVEKIT_TOKEN_TTL=15m

# --- Recording egress (S3-compatible) ---------------------------------------
# Local dev: MinIO in docker-compose, browsable at http://localhost:9001.
# The `egress` container talks to it over the compose network, hence the
# `minio` hostname rather than localhost — localhost from inside that
# container would mean the container itself, not the host.
# Production: point these at a real bucket (AWS S3, R2, Spaces, ...).
RECORDING_ENABLED=false
S3_ENDPOINT=http://minio:9000
S3_REGION=af-south-1
S3_BUCKET=frntdesk-recordings
S3_ACCESS_KEY=frntdesk
S3_SECRET_KEY=frntdesk123
